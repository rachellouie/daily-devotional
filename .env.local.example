# Copy this file to `.env.local` and fill in your real key. `.env.local` is
# gitignored, so your key never gets committed.
#
# Get a free ESV API key (personal / non-commercial use) at:
#   https://api.esv.org/  ->  create an account  ->  "API keys"
#
# This is read on the SERVER only (no NEXT_PUBLIC_ prefix), so it is never sent
# to the browser. See lib/esv.ts.
ESV_API_KEY=your_esv_api_key_here
