# Copy this file to `.env.local` and fill in your keys. `.env.local` is
# gitignored — your keys never get committed.

# API.Bible (scripture.api.bible) — text for ESV, NIV, NLT
# Free Starter plan (non-commercial, 5k calls/month, pick 3 translations).
# Register at: https://scripture.api.bible/
APIBIBLE_API_KEY=your_apibible_key_here

# Bible Brain (faithcomesbyhearing.com) — audio for ESV, NIV, NLT
# Free for non-commercial use.
# Register at: https://www.faithcomesbyhearing.com/bible-brain/developer-documentation
BIBLEBRAIN_API_KEY=your_biblebrain_key_here
